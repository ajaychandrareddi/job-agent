# Copy to .env for local development. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://job_agent:job_agent@localhost:5432/job_agent
DB_ECHO=false

# LLM provider: openai | vertex | anthropic | fake (fake = deterministic, for local/dev without keys)
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Vertex AI only
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

JOB_SEARCH_TIMEZONE=America/New_York
JOB_SEARCH_HOUR=17
JOB_SEARCH_MINUTE=0
INITIAL_SEARCH_DAYS=30
RECURRING_SEARCH_HOURS=24
JOB_MATCH_THRESHOLD=60
MAX_CONCURRENT_JOB_SEARCHES=3
MAX_APPLICATION_RETRIES=2
# Matching rubric weights (percent, must sum to 100) and matching behaviour
MATCHING_WEIGHTS__REQUIRED_SKILLS=30
MATCHING_WEIGHTS__EXPERIENCE_SENIORITY=25
MATCHING_WEIGHTS__RESPONSIBILITIES_ALIGNMENT=20
MATCHING_WEIGHTS__PREFERRED_SKILLS=10
MATCHING_WEIGHTS__EDUCATION_CERTIFICATIONS=5
MATCHING_WEIGHTS__DOMAIN_EXPERIENCE=10
MATCH_LLM_RETRIES=1
MAX_CONCURRENT_MATCHES=4
MATCH_MAX_DESCRIPTION_CHARS=12000
MATCH_CONSISTENCY_TOLERANCE=40
# Missing publication date: exclude_from_auto_apply (route to review) | skip
MISSING_PUBLICATION_DATE_POLICY=exclude_from_auto_apply
# After missed runs: last_window_only (no backlog) | cover_gap (capped by MAX_CATCH_UP_HOURS)
MISSED_RUN_POLICY=last_window_only
MAX_CATCH_UP_HOURS=72
# Clock-skew allowance for postings dated slightly in the future
FUTURE_DATE_TOLERANCE_SECONDS=300

# Applications
GENERATE_APPLICATION_ANSWERS=true
SUBMIT_TIMEOUT_SECONDS=120
RECONCILE_INTERVAL_SECONDS=900
RECONCILE_MAX_ATTEMPTS=5
RECONCILE_NOT_FOUND_MIN_AGE_SECONDS=900
# Greenhouse Job Board API. Requires a key issued by the EMPLOYER for its own board;
# leave empty unless an employer has authorised you. Format: board_token:api_key,...
GREENHOUSE_BOARD_KEYS=
GREENHOUSE_API_BASE=https://boards-api.greenhouse.io/v1

# Scheduler
# A run later than this after its 17:00 slot is a "missed" run
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
# On start-up after missing a run beyond the grace period: run_once | skip
SCHEDULER_MISSED_RUN_ACTION=run_once
SCHEDULER_MAX_WORKERS=4
# How often the schedule is re-synced from the database (picks up API-made changes)
SCHEDULER_RECONCILE_SECONDS=300
# Per-resume run lease (multi-instance coordination); renewed every third of its length
SCHEDULER_RUN_LEASE_SECONDS=900
# Local hour for the daily retention purge
SCHEDULER_MAINTENANCE_HOUR=3

# Job sources (real access requires approved partner credentials; see docs/integrations.md)
LINKEDIN_ENABLED=true
INDEED_ENABLED=true
ZIPRECRUITER_ENABLED=true
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_RETRIES=2
SOURCE_MAX_RETRY_AFTER_SECONDS=120
SOURCE_MAX_RESULTS=500
MAX_DESCRIPTION_CHARS=20000

# Uploads and data retention
MAX_UPLOAD_BYTES=5242880
RESUME_STORAGE_DIR=./var/resumes
RESUME_RETENTION_DAYS=365
APPLICATION_RETENTION_DAYS=730

# API authentication: static_token (dev/test only; refused when APP_ENV=prod) | jwt
API_AUTH_MODE=static_token
# static_token: "token:subject,token2:subject2" (subject = stable user identity)
API_STATIC_TOKENS=
# jwt: HS256 shared secret OR the IdP public key (PEM) for RS256/ES256
API_JWT_SECRET=
API_JWT_PUBLIC_KEY=
API_JWT_ALGORITHMS=RS256
API_JWT_ISSUER=
API_JWT_AUDIENCE=
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_PAGE_SIZE=100
# Run the scheduler inside the API process (single-process deployments)
API_RUN_SCHEDULER=false

LOG_LEVEL=INFO
LOG_JSON=true
